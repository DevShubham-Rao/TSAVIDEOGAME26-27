    {
      "id": "story_01",
      "trigger": {
        "type": "day",
        "level": 1
      },
      "from": "hale",
      "subject": "Orders",
      "body": "Technician. Omega is the last relay on the Chain: everything Home Base sends the survey ships passes through you. The burst jammed your receiver. Crunch the Static into clean packets and I can keep the signal moving.",
      "replies": [
        {
          "text": "On it, Commander.",
          "hint": "+20% Data tomorrow. Hale expects more every day.",
          "effects": [
            {
              "instant": "tomorrow",
              "value": "data_mult",
              "amount": 0.2
            }
          ],
          "trust": {
            "hale": 1
          },
          "followup": "Good. Less talk, more sweeping."
        },
        {
          "text": "Where did the burst come from?",
          "hint": "Dr. Sol gets copied in. Tomorrow: {goldx2}. Shift 10 s shorter.",
          "effects": [
            {
              "instant": "tomorrow",
              "value": "golden_mult",
              "amount": 1.0
            },
            {
              "instant": "tomorrow",
              "value": "shift_seconds",
              "amount": -10
            }
          ],
          "trust": {
            "iva": 1
          },
          "followup": "Not your concern. ...I'm copying the science team. Happy?"
        }
      ]
    },
    {
      "id": "story_02",
      "trigger": {
        "type": "day",
        "level": 2
      },
      "from": "iva",
      "subject": "Your Static has a rhythm",
      "body": "Hi! Dr. Iva Sol, Home Base Science. Quick explainer: Static is signal the burst scrambled, and bits are the clean data hiding inside it. But yesterday's bits repeat in patterns. That is not noise. Can you sort slower tomorrow?",
      "replies": [
        {
          "text": "Sure, I'll take it slow.",
          "hint": "Shift 15 s shorter tomorrow. Sol sends you her Data bonus: +40% Data tomorrow.",
          "effects": [
            {
              "instant": "tomorrow",
              "value": "shift_seconds",
              "amount": -15
            },
            {
              "instant": "tomorrow",
              "value": "data_mult",
              "amount": 0.4
            }
          ],
          "trust": {
            "iva": 1
          },
          "followup": "Thank you! I owe you one. Two, actually."
        },
        {
          "text": "Hale wants speed. Sorry.",
          "hint": "+25% more Static tomorrow. Sol goes quiet for a while.",
          "effects": [
            {
              "instant": "tomorrow",
              "value": "spawn_mult",
              "amount": 0.25
            }
          ],
          "trust": {
            "hale": 1,
            "iva": -1
          },
          "followup": "Oh. Okay. Hale says a lot of things."
        }
      ]
    },
